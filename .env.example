# ==============================================================================
# NIFTY-Pulse Environment Configuration Template
# Copy to .env and configure for local or Azure execution
# ==============================================================================

# Server Runtime
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Azure Platform Settings
AZURE_REGION=centralindia
AZURE_RESOURCE_GROUP=rg-nifty-pulse-prod
AZURE_KEY_VAULT_NAME=kv-nifty-pulse
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# LLM Providers (Optional for external LLM augmentation)
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Engine Timings (Seconds)
MARKET_TICK_INTERVAL_SEC=3
AGENT_SCAN_INTERVAL_SEC=30
